generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  SELL

  RENT
}
enum Role {
  SuperAdmin
  Admin
  Employee
}
model Product {
  id       Int     @id @default(autoincrement())
  name     String
  category String
  size     String?
  color    String?

  salePrice   Float?
  rentalPrice Float?

  stock  Int
  status String

  createdAt DateTime @default(now())
  image     String?

  type ProductType

  storeId Int
  store   Store @relation(fields: [storeId], references: [id])

  rentals Rental[]
  sales   Sale[]
}

model Store {

  id Int @id @default(autoincrement())

  name String

  phone String?

  isActive Boolean @default(true)

  subscriptionStart DateTime @default(now())

  subscriptionEnd DateTime

  plan String @default("Monthly")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users User[]

  products Product[]

  customers Customer[]

  rentals Rental[]

  sales Sale[]

}
model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
role Role @default(Employee)
  storeId  Int

  store     Store    @relation(fields: [storeId], references: [id])
  createdAt DateTime @default(now())
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  address   String
  createdAt DateTime @default(now())
  storeId   Int

  store   Store    @relation(fields: [storeId], references: [id])
  rentals Rental[]
  sales   Sale[]
}

model Rental {
  id         Int      @id @default(autoincrement())
  customerId Int
  productId  Int
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     String   @default("Active")
  createdAt  DateTime @default(now())
  storeId    Int

  store    Store    @relation(fields: [storeId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
}

model Sale {
  id Int @id @default(autoincrement())

  customerId Int
  productId  Int

  quantity Int @default(1)

  totalPrice Float

  soldAt DateTime

  createdAt DateTime @default(now())
  storeId   Int

  store Store @relation(fields: [storeId], references: [id])

  customer Customer @relation(fields: [customerId], references: [id])

  product Product @relation(fields: [productId], references: [id])
}
